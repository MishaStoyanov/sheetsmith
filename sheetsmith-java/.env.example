# ── LLM Provider ─────────────────────────────────────────────────────────────
# Active Spring profiles (comma-separated): ollama | openai | anthropic
SPRING_PROFILES_ACTIVE=ollama

# Ollama (default). This URL is the container docker-compose starts for you.
# Already running Ollama yourself? Use http://host.docker.internal:11434 and start the app with
#   docker compose up postgres sheetsmith-app
# to skip the container and its model download.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# OpenAI  (switch SPRING_PROFILES_ACTIVE=openai to enable)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic  (switch SPRING_PROFILES_ACTIVE=anthropic to enable)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Database ──────────────────────────────────────────────────────────────────
# Still `xlsxai`, on purpose. This is the name of a database that already exists on anyone's
# machine running an earlier build; changing the default would point them at an empty one.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=xlsxai
DB_USERNAME=xlsxai
DB_PASSWORD=xlsxai_pass

# ── File storage ──────────────────────────────────────────────────────────────
# Override only if using bind mounts instead of named volumes
# SHEETSMITH_UPLOAD_DIR=/app/uploads
# SHEETSMITH_RESULT_DIR=/app/results
# SHEETSMITH_SESSION_DIR=/app/sessions
SHEETSMITH_TTL_DAYS=7

# ── Ports on your machine ─────────────────────────────────────────────────────
# Only change these if something already occupies them.
APP_PORT=8080
DB_HOST_PORT=5433
OLLAMA_HOST_PORT=11434

# ── Processing ────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=1

# Cells (columns x rows) one AUTOSIZE_COLUMNS step may measure. Measuring renders every value
# through AWT, so this is the one budget set by the size of the sheet rather than by the range
# the model asked for. Past it, the step sizes what it can afford and reports the rest.
SHEETSMITH_MAX_AUTOSIZE_CELLS=500000

# ── Security ──────────────────────────────────────────────────────────────────
# There is no authentication: any browser origin listed here can drive this
# instance (upload/download files, delete history, overwrite the LLM API keys).
# An intranet deployment must add its own origin here, e.g. http://sheetsmith.corp:8080
SHEETSMITH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# POST /api/excel/improve/path reads and writes server-side paths. Leave it off
# unless you need it; when on, both paths must resolve inside one of the roots
# below (symlinks followed), and enabling it with no roots refuses to start.
SHEETSMITH_PATH_ENDPOINT_ENABLED=false
# SHEETSMITH_PATH_ENDPOINT_ROOTS=/app/uploads,/app/results

# ── Chat ──────────────────────────────────────────────────────────────────────
# Set to false for an improve-only instance. The chat's endpoints, its agent and its read-only
# query tools are then absent from the application entirely — not merely hidden — and the only
# thing that can reach the model is the sheet's structure: sheet names, column headers, ranges
# and existing formula text. "What would you improve?" goes too, since it inspects real values.
SHEETSMITH_CHAT_ENABLED=true
# Budgets for one chat turn: how many tools it may run, and how much data a
# single tool may hand back to the model.
SHEETSMITH_CHAT_MAX_STEPS=8
SHEETSMITH_CHAT_MAX_CELLS=300
SHEETSMITH_CHAT_MAX_ROWS=50
SHEETSMITH_CHAT_HISTORY=12
